{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🟢 Debug KhulisaQuery API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/backend/api/bin/Debug/net8.0/KhulisaQuery.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7001;http://localhost:5001"
      }
    },
    {
      "name": "🟡 Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "🔴 Run SQL Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "/opt/mssql-tools/bin/sqlcmd",
      "args": [
        "-S", "localhost,1433",
        "-U", "sa",
        "-P", "YourPassword123!",
        "-d", "KhulisaCommerce",
        "-i", "${workspaceFolder}/tests/sql/run_all_tests.sql"
      ],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full Stack (API + Frontend)",
      "configurations": [
        "🟢 Debug KhulisaQuery API",
        "🟡 Debug Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
