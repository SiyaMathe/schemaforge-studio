# =============================================================
# SchemaForge Studio — Local Development Environment
# Copy to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================

# ── Local SQL Server (Docker) ─────────────────────────────────
ConnectionStrings__KhulisaCommerce="Server=localhost,1433;Database=KhulisaCommerce;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;"

# ── Azure SQL (Production) — fill from Azure Portal ──────────
# ConnectionStrings__KhulisaCommerce="Server=<server>.database.windows.net;Database=KhulisaCommerce;User Id=sqladmin;Password=<password>;Encrypt=True;"

# ── Application Insights ──────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# ── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL="http://localhost:5001/api"

# ── ASP.NET Core ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_URLS="https://localhost:7001;http://localhost:5001"
